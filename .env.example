# ─────────────────────────────────────────
# .env.example
# Copiar a .env.local y completar los valores.
# NUNCA commitear .env.local al repositorio.
# ─────────────────────────────────────────

# ── MySQL ────────────────────────────────
MYSQL_ROOT_PASSWORD=3xp3ns3_tr4ck3r
MYSQL_DATABASE=expense_tracker
MYSQL_USER=expense_user
MYSQL_PASSWORD=3xp3ns3_tr4ck3r

# Prisma usa esta URL internamente.
# MySQL corre en Docker pero expone el puerto 3306 en localhost.
DATABASE_URL="mysql://expense_user:3xp3ns3_tr4ck3r@127.0.0.1:3306/expense_tracker"

# ── NextAuth.js v5 ───────────────────────
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="super_secret_32_chars_minimum_here"
NEXTAUTH_URL="http://localhost:3000"

# ── IMAP (para lectura de correos) ───────
# Ejemplo: Gmail con contraseña de aplicación
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER="tu_correo@gmail.com"
IMAP_PASSWORD="tu_app_password_aqui"
# Carpeta IMAP a monitorear (INBOX por defecto)
IMAP_MAILBOX="INBOX"

# ── App ──────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Personal Expense Tracker"
