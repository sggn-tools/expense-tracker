// prisma/schema.prisma
// ─────────────────────────────────────────
// Esquema principal de la base de datos.
// Ejecutar: npx prisma migrate dev --name init
// ─────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────
// Usuarios de la aplicación.
// Las contraseñas se almacenan con bcrypt (nunca en texto plano).
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  cards             Card[]
  sessions          Session[]
  accounts          Account[]
  gasolinePurchases GasolinePurchase[]

  @@map("users")
}

// ── Cards ─────────────────────────────────
// Tarjetas bancarias registradas por el usuario.
// La combinación (userId, bankName, lastFour) debe ser única.
model Card {
  id         String   @id @default(cuid())
  userId     String
  bankName   String   // "Banco Agrícola" | "Tarjeta Simán"
  cardType   String   // "VISA" | "MASTERCARD" | "AMEX"
  lastFour   String   @db.Char(4)
  alias      String?  // Nombre amigable: "Visa personal"
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relaciones
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  installments InstallmentPurchase[]

  @@unique([userId, bankName, lastFour])
  @@index([userId])
  @@map("cards")
}

// ── Transactions ──────────────────────────
// Transacciones extraídas de correos bancarios.
// emailMessageId es el Message-ID del header MIME — garantiza idempotencia.
model Transaction {
  id             String   @id @default(cuid())
  cardId         String
  emailMessageId String   @unique  // Previene duplicados
  amount         Decimal  @db.Decimal(10, 2)
  currency       String   @default("USD") @db.Char(3)
  merchant       String
  category       String?  // "Supermercado" | "Gasolina" | etc.
  transactedAt   DateTime
  rawEmailBody   String?  @db.Text  // Cuerpo original para debug
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relaciones
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([transactedAt])
  @@index([cardId, transactedAt])  // Optimiza filtros del dashboard
  @@map("transactions")
}

// ── NextAuth required models ──────────────
// Requeridos por Auth.js v5 con Prisma Adapter

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum InstallmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model InstallmentPurchase {
  id             String             @id @default(cuid())
  cardId         String
  merchant       String
  totalAmount    Decimal            @db.Decimal(10, 2)
  currency       String             @default("USD") @db.Char(3)
  totalMonths    Int
  purchasedAt    DateTime
  firstPaymentAt DateTime
  notes          String?            @db.Text
  status         InstallmentStatus  @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Relaciones
  card           Card                 @relation(fields: [cardId], references: [id], onDelete: Cascade)
  payments       InstallmentPayment[]

  @@index([cardId])
  @@index([status])
  @@map("installment_purchases")
}

model InstallmentPayment {
  id          String   @id @default(cuid())
  purchaseId  String
  monthNumber Int
  dueDate     DateTime
  amount      Decimal  @db.Decimal(10, 2)
  isPaid      Boolean  @default(false)
  paidAt      DateTime?

  // Relaciones
  purchase    InstallmentPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("installment_payments")
}

// ── Gasoline Purchases ─────────────────────
// Compras de gasolina manuales
model GasolinePurchase {
  id          String   @id @default(cuid())
  userId      String
  amount      Decimal  @db.Decimal(10, 2)
  merchant    String   // SHELL, TEXACO, UNO, PUMA, TEXAS GAS
  paymentType String   // Credito, Contado
  purchasedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([merchant])
  @@index([purchasedAt])
  @@map("gasoline_purchases")
}

