# ─────────────────────────────────────────
# Dockerfile.dev — Entorno de desarrollo
# Usar Dockerfile (sin .dev) para producción
# ─────────────────────────────────────────
FROM node:20-alpine

# Dependencias necesarias para Prisma y bcrypt
RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# Instalar dependencias primero (cache layer)
COPY package.json package-lock.json* ./
RUN npm ci

# Copiar el resto del proyecto
COPY . .

# Generar Prisma Client
RUN npx prisma generate

EXPOSE 3000

# Next.js dev server con turbopack
CMD ["npm", "run", "dev"]
